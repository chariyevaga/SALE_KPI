# Application
NODE_ENV=development

# Host-side published ports; container ports are fixed in docker-compose.yml
API_PORT=3000
WEB_PORT=5173

# Optional API URL override for domain/reverse proxy deployments.
# Leave empty to use http://localhost:${API_PORT}.
API_BASE_URL=
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# External KPI application database (SQL Server 2017+)
KPI_DB_HOST=YOUR_KPI_DB_HOST_OR_IP
KPI_DB_PORT=1433
KPI_DB_NAME=KPI_DB
KPI_DB_USER=YOUR_KPI_DB_USER
KPI_DB_PASSWORD=YOUR_KPI_DB_PASSWORD
KPI_DB_ENCRYPT=false
KPI_DB_TRUST_SERVER_CERTIFICATE=true

# Local file storage (mounted as a persistent volume in the API container)
FILE_STORAGE_ROOT=./var/uploads
FILE_MAX_UPLOAD_BYTES=5242880
FILE_CLEANUP_TIME_ZONE=Asia/Ashgabat

# External Logo Tiger database (read-only SQL account, SQL Server 2017+)
FIRM_NR=1
TIGER_DB_HOST=YOUR_TIGER_DB_HOST_OR_IP
TIGER_DB_PORT=1433
TIGER_DB_NAME=TIGERDB
TIGER_DB_USER=YOUR_READ_ONLY_TIGER_USER
TIGER_DB_PASSWORD=YOUR_READ_ONLY_TIGER_PASSWORD
TIGER_DB_ENCRYPT=false
TIGER_DB_TRUST_SERVER_CERTIFICATE=true

# Token authentication; use long, independent random values
ACCESS_TOKEN_SECRET=REPLACE_WITH_ACCESS_TOKEN_SECRET
REFRESH_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_REFRESH_TOKEN_SECRET
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Refresh TTL used when the client does not request "remember me" at login. The web client
# mirrors it as the browser cookie lifetime, so an idle short session dies after this long.
SHORT_SESSION_TTL=20m

# n8n integration
N8N_PORT=5678
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_SECRET=REPLACE_WITH_N8N_WEBHOOK_SECRET
N8N_RUNNERS_AUTH_TOKEN=REPLACE_WITH_INDEPENDENT_N8N_RUNNERS_AUTH_TOKEN
N8N_RUNNERS_BROKER_PORT=5679
N8N_RUNNERS_TASK_TIMEOUT=300
N8N_TIME_ZONE=Asia/Ashgabat
