{
  "name": "retail-kpi",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "description": "Logo Tiger tabanlı bağımsız perakende KPI platformu",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "dev": "pnpm -r --parallel --if-present run dev",
    "lint": "pnpm -r --if-present run lint",
    "migration:check": "npm --prefix apps/api run migration:check",
    "migration:create": "node apps/api/scripts/migration-create.mjs",
    "migration:revert": "npm --prefix apps/api run migration:revert",
    "migration:run": "npm --prefix apps/api run migration:run",
    "migration:show": "npm --prefix apps/api run migration:show",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=12"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
