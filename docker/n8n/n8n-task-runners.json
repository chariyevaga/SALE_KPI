{
  "task-runners": [
    {
      "runner-type": "javascript",
      "workdir": "/home/runner",
      "command": "/usr/local/bin/node",
      "args": ["/opt/runners/task-runner-javascript/dist/start.js"],
      "health-check-server-port": "5681",
      "allowed-env": [
        "PATH",
        "GENERIC_TIMEZONE",
        "NODE_OPTIONS",
        "NODE_PATH",
        "N8N_RUNNERS_AUTO_SHUTDOWN_TIMEOUT",
        "N8N_RUNNERS_TASK_TIMEOUT",
        "N8N_RUNNERS_MAX_CONCURRENCY",
        "N8N_VERSION",
        "HOME"
      ],
      "env-overrides": {
        "NODE_PATH": "/opt/n8n-runner-modules/node_modules",
        "NODE_FUNCTION_ALLOW_BUILTIN": "crypto,fs,path,stream",
        "NODE_FUNCTION_ALLOW_EXTERNAL": "axios,lodash,exceljs,playwright-core",
        "N8N_RUNNERS_INSECURE_MODE": "true",
        "N8N_RUNNERS_HEALTH_CHECK_SERVER_HOST": "0.0.0.0"
      }
    }
  ]
}
