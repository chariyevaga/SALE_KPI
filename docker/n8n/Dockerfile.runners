FROM n8nio/runners:2.35.7

USER root

# Keep Code node dependencies outside n8n's own node_modules tree.
ENV NODE_PATH=/opt/n8n-runner-modules/node_modules

RUN mkdir -p /opt/n8n-runner-modules && \
    cd /opt/n8n-runner-modules && \
    pnpm add \
    axios@1.20.0 \
    lodash@4.18.1 \
    exceljs@4.4.0 \
    playwright-core@1.62.0 && \
    chown -R runner:runner /opt/n8n-runner-modules

COPY docker/n8n/n8n-task-runners.json /etc/n8n-task-runners.json

USER runner

# Only the JavaScript runner is enabled. Python is intentionally not started.
CMD ["javascript"]
